<?xml version="1.0" encoding="utf-8" ?>
<Project>
	<Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(CI)'!='TRUE' And Exists('$(TargetPath)')">
		<MakeDir Directories="$(PluginsPath)" />
		<Copy SourceFiles="$(TargetPath)" DestinationFiles="$(PluginsPath)\$(TargetFileName)" />
		<Message Text="Copied $(TargetFileName) to $(PluginsPath)" Importance="high"/>
	</Target>
</Project>
